DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sellgoods
# Or, for a no-setup local run, use SQLite (the default when DATABASE_URL is unset):
# DATABASE_URL=sqlite:///sellgoods-local.db
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173
# Optional: require signups to use a specific campus email domain.
# CAMPUS_EMAIL_DOMAIN=university.edu
